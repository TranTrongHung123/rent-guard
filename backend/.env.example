# This file belongs ONLY on the laptop backend. Never copy secrets to mobile.
OPENAI_API_KEY=
# Vision + Structured Outputs capable model; change here without rebuilding mobile.
OPENAI_MODEL=gpt-4.1-mini
PORT=4000
HOST=0.0.0.0
OPENAI_TIMEOUT_MS=120000
MAX_PAGES=20
MAX_IMAGE_MB=5
# Browser origins only; React Native does not use browser CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional stable >=32 character secret. If empty, generated once in .data/signing-key.
REPORT_SIGNING_SECRET=
# Verified reports kept only in RAM. 0 disables server cache; signed phone
# history can still be reused after verification. Use forceRefresh for a new run.
ANALYSIS_CACHE_TTL_MS=1800000
ANALYSIS_CACHE_ENTRIES=32
